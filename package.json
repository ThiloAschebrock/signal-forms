{
  "name": "signal-forms",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && eslint --cache --max-warnings=0",
    "lint:fix": "oxlint --fix && eslint --fix --cache --max-warnings=0",
    "lint:migrate": "npx @oxlint/migrate@latest --type-aware --merge",
    "tsc": "tsc --noEmit",
    "test:all": "pnpm tsc && pnpm run lint && pnpm run format:check && pnpm test"
  },
  "dependencies": {
    "@allianz/ng-aquila": "~21.9.0",
    "@angular/cdk": "~22.0.2",
    "@angular/common": "~22.0.2",
    "@angular/compiler": "~22.0.2",
    "@angular/core": "~22.0.2",
    "@angular/forms": "~22.0.2",
    "@angular/platform-browser": "~22.0.2",
    "@angular/router": "~22.0.2",
    "@maskito/angular": "~5.3.1",
    "@maskito/core": "~5.3.1",
    "@maskito/kit": "~5.3.1",
    "@tanstack/angular-query-experimental": "~5.101.0",
    "dayjs": "~1.11.21",
    "decimal.js": "~10.6.0",
    "i18n-iso-countries": "~7.14.0",
    "iban": "~0.0.14",
    "moment": "~2.30.1",
    "ngx-mask": "~21.0.1",
    "rxjs": "~7.8.2",
    "tslib": "~2.8.1",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@angular/build": "~22.0.3",
    "@angular/cli": "~22.0.3",
    "@angular/compiler-cli": "~22.0.2",
    "@testing-library/angular": "~19.4.1",
    "@testing-library/dom": "~10.4.1",
    "@vitest/browser": "~4.1.9",
    "@vitest/browser-playwright": "~4.1.9",
    "angular-eslint": "~22.0.0",
    "eslint": "~10.5.0",
    "eslint-plugin-oxlint": "~1.70.0",
    "oxfmt": "~0.55.0",
    "oxlint": "~1.70.0",
    "oxlint-tsgolint": "~0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.61.1",
    "vitest": "~4.1.9"
  },
  "engines": {
    "node": ">=24.15.0",
