{
  "name": "signal-forms",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && eslint --cache --max-warnings=0",
    "lint:fix": "oxlint --fix && eslint --fix --cache --max-warnings=0",
    "lint:migrate": "npx @oxlint/migrate@latest --type-aware --merge",
    "tsc": "tsc --noEmit",
    "test:all": "pnpm tsc && pnpm run lint && pnpm run format:check && pnpm test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@allianz/ng-aquila": "^22.2.0",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@maskito/angular": "^5.4.0",
    "@maskito/core": "^5.4.0",
    "@maskito/kit": "^5.4.0",
    "@tanstack/angular-query-experimental": "^5.102.0",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "i18n-iso-countries": "^7.14.0",
    "iban": "^0.0.14",
    "moment": "^2.30.1",
    "ngx-mask": "^22.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@testing-library/angular": "^19.4.2",
    "@testing-library/dom": "^10.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-oxlint": "^1.79.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": "Please use pnpm instead",
    "pnpm": ">=10.0.0",
    "yarn": "Please use pnpm instead"
  },
  "packageManager": "pnpm@11.22.0"
}
